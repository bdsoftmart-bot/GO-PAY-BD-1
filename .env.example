# ============================================================================
# GO PAY BD — Environment Configuration Template
# Copy this file to .env on your cPanel server (NEVER commit .env to Git!)
# ============================================================================

# Server Runtime
NODE_ENV=production
PORT=3000

# Public Application URLs (no trailing slash)
APP_URL=https://gopaybd.store
FRONTEND_URL=https://gopaybd.store
# Comma-separated strict CORS & CSRF origin allowlist (include www if used)
ALLOWED_ORIGINS=https://gopaybd.store,https://www.gopaybd.store

# MySQL Database (Create database + user in cPanel > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_db_name
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_strong_db_password

# Session & Cookie Security (Generate a 64-char random hex string — REQUIRED in production)
SESSION_SECRET=replace_with_a_long_random_64_char_secret_string
SESSION_TTL_DAYS=7
COOKIE_SAME_SITE=lax

# Admin Control Center Password
# Precedence: 1) Individual staff account in `admins` (when email provided),
# 2) Rotated master password stored in MySQL `admin_security_vault`,
# 3) Fallback to ADMIN_PASSWORD env var below when vault is not yet set.
# Never commit real passwords to Git.
ADMIN_PASSWORD=replace_with_strong_admin_password

# File Uploads Directory (relative to app root or absolute path outside src)
UPLOAD_DIR=uploads

# Optional: Google OAuth Sign-In for Regular Users
# Leave blank to disable Google login and use Email/Password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://gopaybd.store/auth/google/callback

# Optional: SMTP for Password Reset Emails (leave blank if using support-assisted reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gopaybd.store
